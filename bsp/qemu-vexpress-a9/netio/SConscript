import os
from building import *

# Get the current directory
cwd = GetCurrentDir()

# Define source files
src = Glob('*.c')  # Automatically find all `.c` files in the current directory

# Define include paths
CPPPATH = [cwd]

# Define dependencies
DEPEND = ['lwip']  # Ensure lwIP is available for TCP/IP stack

# Define the build group
group = DefineGroup(
    'NetIO',      # Module name
    src,          # Source files
    depend=DEPEND,  # Dependencies
    CPPPATH=CPPPATH  # Include paths
)

# Return the group to SConstruct
Return('group')
